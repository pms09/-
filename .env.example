# 이 파일을 복사해서 .env.local 을 만드세요 (.env.local 은 git에 커밋되지 않습니다).
#   cp .env.example .env.local

# Google Gemini API 키 — 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# AI 호출은 app/api/recommend 서버 라우트에서만 이루어지며 키는 브라우저로 전달되지 않습니다.
GEMINI_API_KEY=

# (선택) 사용할 모델 이름. 미설정 시 gemini-flash-latest 사용.
# GEMINI_MODEL=gemini-flash-latest
