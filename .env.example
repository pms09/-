# 이 파일을 복사해서 .env.local 을 만드세요 (.env.local 은 git에 커밋되지 않습니다).
#   cp .env.example .env.local
#
# 배포 환경(Vercel)에서는 이 값들을 Settings → Environment Variables 에 등록하세요.
# 모두 서버 전용입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.

# --- Google Gemini (AI 추천) ---
# AI 호출은 app/api/recommend 서버 라우트에서만 이루어지며 키는 브라우저로 전달되지 않습니다.
GEMINI_API_KEY=

# (선택) 사용할 모델 이름. 미설정 시 gemini-flash-latest 사용.
# GEMINI_MODEL=gemini-flash-latest

# --- Supabase (현황 기록 저장) ---
# Supabase 대시보드 → Project Settings → Data API 에서 확인.
# 둘 다 설정되면 Postgres에 영구 저장하고, 하나라도 없으면 메모리(mock) 저장소로 동작합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
